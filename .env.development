# Firebase Local Emulator Suite (project id "demo-neon-snake", see backend/).
VITE_ANALYTICS_URL=http://127.0.0.1:5001/demo-neon-snake/us-central1/collectEvents
# Events per analytics request for dev builds only; production builds read no value and use 20.
# Keep it at or below 100: the backend rejects larger batches (MAX_BATCH_SIZE). The client caps
# it at 100 too. Only a missing or zero/non-numeric value falls back to 20; negative or fractional
# values are not validated, so use positive whole numbers.
VITE_ANALYTICS_BATCH_SIZE=20
