{
  "name": "snake-game-starter",
  "version": "1.0.0",
  "description": "A small browser game starter for the Famobi development challenge.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.game.config.ts && node scripts/inject-game-size.mjs",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "dashboard:install": "npm --prefix dashboard install",
    "dashboard:dev": "npm --prefix dashboard run dev",
    "dashboard:build": "npm --prefix dashboard run build",
    "dashboard:test": "npm --prefix dashboard test",
    "backend:install": "npm --prefix backend/functions install",
    "emulators": "npm --prefix backend/functions run emulators",
    "backend:test": "npm --prefix backend/functions test",
    "backend:test:integration": "npm --prefix backend/functions run test:integration"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.1.3"
}
